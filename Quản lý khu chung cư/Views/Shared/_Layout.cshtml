<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản_lý_khu_chung_cư</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
@*     <link rel="stylesheet" href="~/Quản_lý_khu_chung_cư.styles.css" asp-append-version="true" />
 *@</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Quản_lý_khu_chung_cư</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" id="cuDanDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Chức Năng Cư Dân
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="cuDanDropdown">
                                <li><a class="dropdown-item" asp-area="CuDan" asp-controller="CuDan" asp-action="ThongBao">Xem Thông Báo</a></li>
                                <li><a class="dropdown-item" asp-area="CuDan" asp-controller="CuDan" asp-action="TienIch">Danh Sách Tiện Ích</a></li>
                                <li><a class="dropdown-item" asp-area="CuDan" asp-controller="CuDan" asp-action="GuiPhanHoi">Gửi Phản Hồi</a></li>
                                <li><a class="dropdown-item" asp-area="CuDan" asp-controller="CuDan" asp-action="PhiDichVu">Xem và Thanh Toán Phí Dịch Vụ</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" id="quanLyDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Chức Năng Quản Lý
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="quanLyDropdown">
                                <li><a class="dropdown-item" asp-area="QuanLy" asp-controller="QuanLy" asp-action="GuiThongBao">Gửi Thông Báo</a></li>
                                <li><a class="dropdown-item" asp-area="QuanLy" asp-controller="QuanLy" asp-action="DanhSachCuDan">Danh Sách Cư Dân</a></li>
                                <li><a class="dropdown-item" asp-area="QuanLy" asp-controller="QuanLy" asp-action="LichBaoTri">Lịch Bảo Trì</a></li>
                                <li><a class="dropdown-item" asp-area="QuanLy" asp-controller="QuanLy" asp-action="TienIch">Quản Lý Tiện Ích</a></li>
                                <li><a class="dropdown-item" asp-area="QuanLy" asp-controller="QuanLy" asp-action="PhanHoi">Xem Phản Hồi</a></li>
                                <li><a class="dropdown-item" asp-area="QuanLy" asp-controller="QuanLy" asp-action="XuatHoaDon">Xuất Hóa Đơn</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" id="baoVeDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Chức Năng Bảo Vệ
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="baoVeDropdown">
                                <li><a class="dropdown-item" asp-area="BaoVeVaNhanVienQuanLy" asp-controller="BaoVe" asp-action="DanhSachPhanAnh">Danh Sách Phản Ánh</a></li>
                                <li><a class="dropdown-item" asp-area="BaoVeVaNhanVienQuanLy" asp-controller="BaoVe" asp-action="DanhSachBaoTri">Danh Sách Bảo Trì</a></li>
                            </ul>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Quản_lý_khu_chung_cư - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
